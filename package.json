{
  "name": "pi-zcode",
  "version": "0.1.4",
  "description": "ZCode / Z.AI model provider for Pi Coding Agent",
  "type": "module",
  "main": "./src/index.ts",
  "author": "xifan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xifan2333/pi-zcode.git"
  },
  "bugs": {
    "url": "https://github.com/xifan2333/pi-zcode/issues"
  },
  "homepage": "https://github.com/xifan2333/pi-zcode#readme",
  "files": [
    "README.md",
    "README.zh-CN.md",
    "src",
    "index.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src index.ts tests",
    "lint:fix": "oxlint --fix src index.ts tests",
    "test": "node --experimental-transform-types --import ./tests/ts-resolve.mjs --test tests/*.test.ts",
    "test:integration": "node --experimental-transform-types --import ./tests/ts-resolve.mjs --test tests/lifecycle.integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && oxlint src index.ts tests && prettier --check ."
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-provider",
    "zcode",
    "z.ai",
    "bigmodel",
    "glm",
    "glm-5"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.2",
    "@earendil-works/pi-coding-agent": ">=1.0.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "^26.1.1",
    "oxlint": "^1.78.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "happy-dom": "^20.13.1",
    "undici": "^8.10.1"
  }
}
